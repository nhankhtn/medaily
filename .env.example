# Every variable this app reads is listed here, uncommented, so the file is a
# map of what exists rather than a pile of things you have to know to look for.
# A blank value means *not set*: the feature behind it stays switched off and
# nothing is validated. Fill in only what you need.

# PostgreSQL connection string (required)
DATABASE_URL=postgres://awish@localhost:5432/medaily

# Node environment
NODE_ENV=development

# The address people actually paste, used for the link preview card and for
# robots.txt. On Vercel the project's own production hostname is used when this
# is blank, so it only needs filling in for a custom domain.
#   SITE_URL=https://medaily.example.com
SITE_URL=

# A second way to reach you, named in the privacy notice beside the contact
# form. Blank and the notice points at the form alone, which is on the front
# page and needs no account — the form covers the person most likely to write
# in, the one who cannot sign in or has already deleted their account. Do not
# put a personal address here: that page is indexed.
#   LEGAL_CONTACT_EMAIL=hello@example.com
LEGAL_CONTACT_EMAIL=

# Vercel Web Analytics and Speed Insights. Off unless this is set, so nothing
# counts a developer or reports from a build that is not on Vercel. Turning it
# on changes what the privacy notice has to say — see src/lib/legal.
#   NEXT_PUBLIC_ANALYTICS_ENABLED=1
NEXT_PUBLIC_ANALYTICS_ENABLED=

# `medaily-ai`, the service that talks to the models. It answers the
# quick-capture box, the review chat, the written AI review and the assistant.
# Without it none of them is offered and every manual form works exactly as
# before. The provider keys and the model chain live over there now, not here.
#   AI_SERVICE_URL=https://ai.example.com
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# Sign-in (single user, hard-coded). Without all three the app refuses every
# request except /api/health — a misconfigured deploy must never be open.
AUTH_USERNAME=me
AUTH_PASSWORD=change-me
# openssl rand -hex 32
AUTH_SECRET=

# ── Google sign-in via Firebase (optional) ───────────────────────────────────
# Only the project id is needed server-side: ID tokens are verified against
# Google's public keys, so there is no service account file and no extra secret.
# These NEXT_PUBLIC_ values are not secrets — Firebase web config identifies the
# project, it does not authorise anything.
#   FIREBASE_PROJECT_ID=your-project
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
# Auth domain is the *app* host at runtime (see firebase-client). Keep this as
# the Firebase default for local tooling; production Google OAuth must also
# allow https://<your-app>/__/auth/handler (next.config proxies /__/auth).
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Google One Tap — the card offering accounts already signed in to the browser.
# Blank, the card never appears and the sign-in page is unchanged.
# This is the OAuth *web* client id from Google Cloud Console → Credentials,
# and every origin the app is served from must be listed there under Authorized
# JavaScript origins or Google refuses to draw anything, silently. Note that
# http://localhost:3000 and http://127.0.0.1:3000 count as different origins.
# One Tap does not work on iOS at all — Google requires FedCM and no iOS browser
# has it — so on a phone the remembered-account chips are the shortcut instead.
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Chat updates arriving by themselves, through Firestore. Blank and chat still
# works: it asks again on a slow timer, which is also what somebody signed in
# with the password gets, since that path has no Firebase session to listen
# with. Firestore holds no message text — one document per room with a counter
# and a time, nothing else. Rules are in firestore.rules, deployed by hand.
#   NEXT_PUBLIC_REALTIME_ENABLED=1
NEXT_PUBLIC_REALTIME_ENABLED=

# Push notifications (docs/realtime.md). Blank and the notifications card never
# appears; chat still works, it just does not reach a phone that is put down.
#
# The Web Push certificate key pair, from Firebase Console -> Project settings
# -> Cloud Messaging -> Web configuration. Public by design: it identifies the
# project to the browser's push service, it does not authorise sending.
#   NEXT_PUBLIC_FIREBASE_VAPID_KEY=B...
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Sending uses FIREBASE_SERVICE_ACCOUNT below, which therefore needs
# `roles/firebasemessaging.admin` on top of `roles/datastore.user`.
#
# iOS delivers web push only to an app added to the Home Screen — not a Safari
# tab, and not Chrome, which is the same WebKit underneath. The settings card
# says so instead of offering a button that cannot work.

# Two things read this (docs/realtime.md): the nightly sweep of what the
# doorbell leaves behind, and the custom token that gives a password sign-in a
# Firebase identity to type under.
#
# Blank and nothing is swept — a deleted room and every rotated doorbell key
# leave a couple of numeric fields behind, untidy rather than harmful — and
# the typing indicator works only for people who signed in with Google, which
# on an iPhone is close to nobody. Messages are unaffected either way.
#
# It has to run server-side — after a key rotates nobody holds the old one, so
# no browser can reach that document even to delete it.
#
# The whole service-account JSON on one line: two variables would mean a private
# key with real newlines in an environment variable, and inside JSON they stay
# escaped. Needs `roles/datastore.user` and nothing more, and its project_id is
# checked against NEXT_PUBLIC_FIREBASE_PROJECT_ID so a staging key cannot delete
# from production.
#
# This is the only Firebase credential here with any power. Sign-in and the
# doorbell run on public keys and security rules and never need it.
#   FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
FIREBASE_SERVICE_ACCOUNT=

# Analytics only, and both are needed before anything is counted. Firebase
# console -> Project settings -> Your apps (app id), and the Analytics tab
# for the G- measurement id. Sign-in works without them.
#   NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=
#   NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Who may sign in. Left blank, only the owner can: an unknown Google account is
# refused rather than handed a new workspace.
# This address links to the existing owner row instead of creating a new one:
#   AUTH_OWNER_EMAIL=you@gmail.com
AUTH_OWNER_EMAIL=
# Comma separated; either list is enough to be let in.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# Set to true to let any permitted address create its own workspace.
AUTH_ALLOW_SIGNUP=

# Sent back by the scheduler on /api/cron/sweep-images, which deletes note
# pictures nothing points at any more. Blank and that route refuses to run.
CRON_SECRET=

# The second database. It holds the trail of what was created, changed and
# deleted, and — since chat — the rooms, members, invites and messages too.
# Blank, neither is offered and the driver never connects. Only the trail
# expires, after ACTIVITY_LOG_DAYS (90 when left blank); a conversation that
# deleted itself after a while would be a bug, not a policy.
#   MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/medaily
MONGODB_URI=
ACTIVITY_LOG_DAYS=

# Locks the words of a chat message before they reach the database, so a dump,
# a stray backup or whoever runs the cluster finds nothing to read. The server
# still holds the key, so this is not end-to-end: it protects the database,
# not the machine. Blank and messages are written as they always were — rows
# of both kinds live together, and nothing has to be migrated to switch this
# on. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Lose it and the messages are gone, so keep a copy somewhere that is not the
# database. SPARE is a second key that opens everything the first one does:
# the way back in when the main key is lost, and the way through a rotation.
# Set both before the first message is written — a key added later opens
# nothing that was written before it.
CHAT_MESSAGE_KEY=
CHAT_MESSAGE_KEY_SPARE=

# Photo storage (Cloudinary). Without these the photo UI stays hidden.
# The secret signs uploads server-side; files go straight from the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Everything is filed under <folder>/<userId>/<kind>/<ownerId>:
CLOUDINARY_FOLDER=medaily

# Crash alerts to a Telegram chat (optional). Without both, nothing is sent and
# errors go to the console exactly as before.
# Make a bot with @BotFather, message it once, then read your chat id from
#   https://api.telegram.org/bot<token>/getUpdates
# Set these on the deploy, not here: in .env.local every local typo buzzes your
# phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
