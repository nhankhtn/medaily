# PostgreSQL connection string (required)
DATABASE_URL=postgres://awish@localhost:5432/medaily

# Node environment
NODE_ENV=development

# Optional: `medaily-ai`, the service that talks to the models. It answers the
# quick-capture box, the review chat, the written AI review and the assistant.
# Without it none of them is offered and every manual form works exactly as
# before. The provider keys and the model chain live over there now, not here.
# AI_SERVICE_URL=https://ai.example.com
# AI_SERVICE_TOKEN=

# Sign-in (single user, hard-coded). Without all three the app refuses every
# request except /api/health — a misconfigured deploy must never be open.
AUTH_USERNAME=me
AUTH_PASSWORD=change-me
# openssl rand -hex 32
AUTH_SECRET=

# ── Google sign-in via Firebase (optional) ───────────────────────────────────
# Only the project id is needed server-side: ID tokens are verified against
# Google's public keys, so there is no service account file and no extra secret.
# These NEXT_PUBLIC_ values are not secrets — Firebase web config identifies the
# project, it does not authorise anything.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# Auth domain is the *app* host at runtime (see firebase-client). Keep this as
# the Firebase default for local tooling; production Google OAuth must also
# allow https://<your-app>/__/auth/handler (next.config proxies /__/auth).
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project

# Who may sign in. Left as-is, only the owner can: an unknown Google account is
# refused rather than handed a new workspace.
# This address links to the existing owner row instead of creating a new one:
# AUTH_OWNER_EMAIL=you@gmail.com
# Comma separated; either list is enough to be let in.
# AUTH_ALLOWED_EMAILS=
# AUTH_ALLOWED_DOMAINS=
# Set to true to let any permitted address create its own workspace.
# AUTH_ALLOW_SIGNUP=false

# Photo storage (Cloudinary). Without these the photo UI stays hidden.
# The secret signs uploads server-side; files go straight from the browser.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Everything is filed under <folder>/<userId>/<kind>/<ownerId>:
# CLOUDINARY_FOLDER=medaily

# Crash alerts to a Telegram chat (optional). Without both, nothing is sent and
# errors go to the console exactly as before.
# Make a bot with @BotFather, message it once, then read your chat id from
#   https://api.telegram.org/bot<token>/getUpdates
# Set these on the deploy, not here: in .env.local every local typo buzzes your
# phone.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
